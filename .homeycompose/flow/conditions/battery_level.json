{
  "title": {
    "en": "Battery level comparison"
  },
  "titleFormatted": {
    "en": "Battery level of [[device]] is above [[percentage]]%"
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "capabilities=measure_battery",
      "title": {
        "en": "Device"
      }
    },
    {
      "type": "range",
      "name": "percentage",
      "title": {
        "en": "Percentage"
      },
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "%",
      "labelMultiplier": 1,
      "labelDecimals": 0
    }
  ]
}
