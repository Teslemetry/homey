{
  "title": {
    "en": "Set charge limit"
  },
  "titleFormatted": {
    "en": "Set [[device]] charge limit to [[percentage]]%"
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "capabilities=charge_limit",
      "title": {
        "en": "Device"
      }
    },
    {
      "type": "range",
      "name": "percentage",
      "title": {
        "en": "Percentage"
      },
      "min": 0,
      "max": 100,
      "step": 1,
      "label": "%",
      "labelMultiplier": 1,
      "labelDecimals": 0
    }
  ]
}
