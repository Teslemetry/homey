    {
      "id": "alarm_generic.off_grid_true",
      "title": {
        "en": "Grid power has been lost",
        "nl": "Netstroom is uitgevallen",
        "da": "Netstrøm er blevet afbrudt",
        "de": "Netzstrom ist ausgefallen",
        "es": "Se ha perdido la energía de la red",
        "fr": "L'alimentation électrique a été coupée",
        "it": "La corrente di rete è stata persa",
        "no": "Nettstrømmen har blitt borte",
        "sv": "Strömmen från elnätet har förlorats",
        "pl": "Zasilanie sieciowe zostało utracone",
        "ru": "Сетевая электроэнергия отключена",
        "ko": "전력망의 전기가 끊겼습니다",
        "ar": "تم فقدان طاقة الشبكة"
      }
    },
    {
      "id": "alarm_generic.off_grid_false",
      "title": {
        "en": "Grid power has been restored",
        "nl": "Netstroom is hersteld",
        "da": "Netstrømmen er blevet genoprettet",
        "de": "Netzstrom wurde wiederhergestellt",
        "es": "La energía de la red ha sido restaurada",
        "fr": "L'alimentation électrique a été rétablie",
        "it": "La corrente di rete è stata ripristinata",
        "no": "Nettstrømmen er blitt gjenopprettet",
        "sv": "Strömmen från elnätet har återställts",
        "pl": "Zasilanie sieciowe zostało przywrócone",
        "ru": "Сетевая электроэнергия восстановлена",
        "ko": "전력망의 전력이 복구되었습니다",
        "ar": "تم استعادة طاقة الشبكة"
      }
    },
