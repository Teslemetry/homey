{
  "triggers": [
    {
      "id": "grid_outage_started",
      "title": {
        "en": "A real grid outage has started"
      },
      "hint": {
        "en": "Fires for an unplanned, unintentional grid outage - not a user-initiated Go Off-Grid test."
      }
    },
    {
      "id": "grid_outage_ended",
      "title": {
        "en": "A real grid outage has ended"
      }
    },
    {
      "id": "island_test_started",
